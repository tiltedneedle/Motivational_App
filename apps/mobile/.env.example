# Copy to apps/mobile/.env and fill in. Every value here is public by design —
# the anon key is meant to ship in the app; row level security protects the
# rows. Nothing secret ever goes in this file. Without any of these the app
# runs whole on the device.

# The account and the edge functions (README, "What needs a key").
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Only if the edge functions are hosted somewhere other than the Supabase
# project above. Leave empty otherwise.
EXPO_PUBLIC_MORROW_API=

# Product analytics (PostHog). Events carry numbers and fixed names only —
# never a word the person wrote. Empty means no analytics at all.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# RevenueCat public SDK keys, one per store.
EXPO_PUBLIC_RC_IOS=
EXPO_PUBLIC_RC_ANDROID=
