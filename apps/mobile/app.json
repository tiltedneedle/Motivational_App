{
  "expo": {
    "name": "Morrow",
    "slug": "morrow",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "morrow",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": { "supportsTablet": true, "bundleIdentifier": "app.morrow.client" },
    "android": { "package": "app.morrow.client", "edgeToEdgeEnabled": true },
    "web": { "bundler": "metro", "output": "single" },
    "plugins": ["expo-router", "expo-font"],
    "experiments": { "typedRoutes": false }
  }
}
