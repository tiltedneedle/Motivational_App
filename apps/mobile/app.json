{
  "expo": {
    "name": "Morrow",
    "slug": "morrow",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "morrow",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.morrow.client",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.morrow.client",
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F1F0EC"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": "production",
            "default": false
          }
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F1F0EC"
        }
      ],
      "expo-sharing",
      "expo-apple-authentication",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Morrow saves your lock screen — your own line, typeset — to Photos. It never reads your photos.",
          "photosPermission": "Morrow only ever adds an image to Photos; it does not look at what is there."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Morrow listens so you can say your writing instead of typing it. Nothing is recorded; only the words are kept.",
          "speechRecognitionPermission": "Turns what you say into the words of your Book, on this phone where it can."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#EA4B2E",
          "defaultChannel": "morrow"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
