{
  "expo": {
    "name": "Morrow",
    "slug": "morrow",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "morrow",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.morrow.client"
    },
    "android": {
      "package": "app.morrow.client"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
